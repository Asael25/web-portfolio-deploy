---
// Story.astro - Curated Homepage Showcase (Top 3 Photos) + Button ke /galeri
const featuredStoryItems = [
  {
    num: "01",
    tag: "[01] MOMEN WISUDA",
    sub: "SURYA ASAEL, S.Kom",
    title: "Wisuda & Gelar Sarjana Komputer (S.Kom)",
    desc: "Puncak perjalanan akademik di Universitas 17 Agustus 1945 Surabaya setelah menyelesaikan seluruh program studi, riset kompetisi, dan sidang skripsi.",
    img: "/images/story/wisuda-skom.png",
    aspect: "aspect-portrait",
    category: "Akademik & Kelulusan"
  },
  {
    num: "02",
    tag: "[02] GOLD MEDAL JISF",
    sub: "JAKARTA INTL SCIENCE FAIR 2025",
    title: "Tim Juara 1 Gold Medal JISF 2025",
    desc: "Kolaborasi riset inovasi hardware 'Smart Fruit Salad Box' bersama tim mahasiswa Teknik Informatika UNTAG Surabaya hingga meraih medali emas internasional.",
    img: "/images/jisf-gold-team.png",
    aspect: "aspect-landscape",
    category: "Kompetisi Internasional"
  },
  {
    num: "03",
    tag: "[03] MAGANG KEDINASAN",
    sub: "DINAS PU BINA MARGA JATIM",
    title: "Meeting & Implementasi di Dinas PU Bina Marga",
    desc: "Momen koordinasi dan evaluasi sistem web e-archive & e-inventory bersama tim pengembang dan pembimbing lapangan di kantor Dinas PU Bina Marga Jawa Timur.",
    img: "/images/magang-bina-marga.jpg",
    aspect: "aspect-landscape",
    category: "Pengalaman Kerja"
  }
];
---

<section class="gallery-section" id="story">
  <div class="container">
    <div class="gallery-header">
      <div class="section-tag font-mono">// ARSIP MAHASISWA & RISET TERPILIH</div>
      <h2 class="section-title">Dokumentasi Rekam Jejak</h2>
      <p class="section-subtitle">
        Cuplikan rekam jejak nyata semasa menempuh studi: momen kelulusan sarjana, penghargaan medali emas kompetisi internasional, hingga pengalaman kerja magang di instansi kedinasan.
      </p>
    </div>

    <!-- Curated 3-Card Showcase Grid -->
    <div class="gallery-grid">
      {featuredStoryItems.map((item) => (
        <div class={`gallery-card ${item.aspect}`}>
          <div 
            class="photo-wrapper" 
            data-full={item.img} 
            data-title={item.title} 
            data-tag={item.tag}
            role="button"
            tabindex="0"
            aria-label={`Buka foto ${item.title}`}
          >
            <img 
              src={item.img} 
              alt={item.title} 
              class="gallery-img"
              loading="lazy"
            />
            <div class="photo-overlay">
              <span class="photo-tag font-mono" set:html={item.tag} />
              <span class="photo-sub font-mono" set:html={item.sub} />
            </div>
            <div class="photo-zoom-hint font-mono">[PERBESAR]</div>
          </div>

          <div class="card-caption font-mono">
            <span class="cap-num">{item.num}.</span>
            <div class="cap-body">
              <div class="cap-cat font-mono">// {item.category.toUpperCase()}</div>
              <h3 class="cap-title">{item.title}</h3>
              <p class="cap-desc">{item.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Direct CTA to Full Gallery Page -->
    <div class="gallery-cta-wrapper">
      <div class="cta-inner">
        <div class="cta-info font-mono">
          <span class="cta-tag">// ARSIP LENGKAP TERSEDIA</span>
          <span class="cta-count">[7 DOKUMENTASI FOTO]</span>
        </div>
        <a href="/galeri" class="btn btn-primary btn-all-gallery">
          <span>Lihat Semua Dokumentasi & Arsip Lengkap</span>
          <span class="font-mono">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal for Full-res Photo Inspection -->
  <div id="galleryModal" class="gallery-modal" aria-hidden="true">
    <div class="modal-backdrop" id="modalBackdrop"></div>
    <div class="modal-content">
      <button class="modal-close" id="modalClose" aria-label="Tutup Pratinjau Foto">&times;</button>
      <div class="modal-image-box">
        <img id="modalImg" src="" alt="Detail Foto Galeri" />
      </div>
      <div class="modal-meta font-mono">
        <span id="modalTag" class="modal-tag"></span>
        <h4 id="modalTitle" class="modal-title"></h4>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--border-light);
    position: relative;
    background: var(--bg-primary);
  }

  .gallery-header {
    margin-bottom: 44px;
    text-align: left;
  }

  /* 3-Column Showcase Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 28px;
    align-items: start;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: var(--transition);
  }

  /* Photo Wrapper */
  .photo-wrapper {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-light);
    background: var(--bg-secondary);
    transition: var(--transition);
    cursor: zoom-in;
    width: 100%;
  }

  .aspect-portrait {
    aspect-ratio: 3 / 4;
  }

  .aspect-landscape {
    aspect-ratio: 16 / 11;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-wrapper:hover {
    border-color: var(--border-strong);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .photo-wrapper:hover .gallery-img {
    transform: scale(1.03);
  }

  .photo-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 12px 14px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0) 100%);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: #ffffff;
    font-size: 0.7rem;
    pointer-events: none;
    z-index: 2;
  }

  .photo-tag {
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .photo-sub {
    color: #e4e4e7;
    font-size: 0.66rem;
  }

  .photo-zoom-hint {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    opacity: 0;
    transform: translateY(-4px);
    transition: var(--transition);
    pointer-events: none;
    z-index: 2;
  }

  .photo-wrapper:hover .photo-zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  /* Captions */
  .card-caption {
    margin-top: 14px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    text-align: left;
  }

  .cap-num {
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .cap-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cap-cat {
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .cap-title {
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .cap-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* CTA Button Wrapper */
  .gallery-cta-wrapper {
    margin-top: 50px;
    padding-top: 32px;
    border-top: 1px dashed var(--border-light);
  }

  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    gap: 20px;
  }

  .cta-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.82rem;
  }

  .cta-tag {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .cta-count {
    color: var(--text-muted);
  }

  .btn-all-gallery {
    padding: 12px 24px;
    font-size: 0.88rem;
    white-space: nowrap;
    text-decoration: none;
  }

  /* Lightbox Modal */
  .gallery-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 24px;
  }

  .gallery-modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    max-width: 900px;
    max-height: 92vh;
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    z-index: 10;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
    animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 24px;
    line-height: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 20;
    transition: var(--transition);
  }

  .modal-close:hover {
    background: #000000;
    transform: scale(1.1);
  }

  .modal-image-box {
    width: 100%;
    max-height: 72vh;
    background: #09090b;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  #modalImg {
    max-width: 100%;
    max-height: 72vh;
    object-fit: contain;
    display: block;
  }

  .modal-meta {
    padding: 18px 24px;
    background: var(--bg-card);
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .modal-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .modal-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Responsive Rules */
  @media (max-width: 968px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .btn-all-gallery {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  function initGalleryLightbox() {
    const modal = document.getElementById('galleryModal');
    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalTag = document.getElementById('modalTag');
    const modalTitle = document.getElementById('modalTitle');
    const modalClose = document.getElementById('modalClose');
    const backdrop = document.getElementById('modalBackdrop');

    if (!modal || !modalImg || !modalTag || !modalTitle) return;

    function openModal(imgSrc: string, tag: string, title: string) {
      modalImg.src = imgSrc;
      modalTag.innerHTML = tag;
      modalTitle.textContent = title;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      modalImg.src = '';
    }

    document.querySelectorAll('.photo-wrapper').forEach((wrapper) => {
      wrapper.addEventListener('click', () => {
        const full = wrapper.getAttribute('data-full') || '';
        const tag = wrapper.getAttribute('data-tag') || '';
        const title = wrapper.getAttribute('data-title') || '';
        openModal(full, tag, title);
      });

      wrapper.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          const full = wrapper.getAttribute('data-full') || '';
          const tag = wrapper.getAttribute('data-tag') || '';
          const title = wrapper.getAttribute('data-title') || '';
          openModal(full, tag, title);
        }
      });
    });

    modalClose?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryLightbox);
  } else {
    initGalleryLightbox();
  }
</script>
