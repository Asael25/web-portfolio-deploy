---
// ParticlePortrait.astro - High Performance Stippled Particle Portrait (PT Amman Style)
---

<div class="particle-portrait-wrapper" id="portraitWrapper">
  <canvas id="particlePortraitCanvas" class="particle-canvas"></canvas>
</div>

<style>
  .particle-portrait-wrapper {
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    user-select: none;
  }

  .particle-canvas {
    width: 100%;
    height: auto;
    max-height: 540px;
    display: block;
    cursor: crosshair;
    filter: drop-shadow(0 16px 32px rgba(0, 0, 0, 0.08));
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .particle-canvas.ready {
    opacity: 1;
  }

  @media (max-width: 968px) {
    .particle-portrait-wrapper {
      max-width: 280px;
    }

    .particle-canvas {
      max-height: 400px;
    }
  }

  @media (max-width: 480px) {
    .particle-portrait-wrapper {
      max-width: 230px;
    }

    .particle-canvas {
      max-height: 320px;
    }
  }
</style>

<script>
  interface Particle {
    homeX: number;
    homeY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    luminance: number;
  }

  function initParticlePortrait() {
    const canvas = document.getElementById('particlePortraitCanvas') as HTMLCanvasElement;
    const wrapper = document.getElementById('portraitWrapper');
    if (!canvas || !wrapper) return;

    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return;

    const img = new Image();
    img.src = '/images/surya-hero-clean.png';
    img.crossOrigin = 'anonymous';

    let particles: Particle[] = [];
    let isInitialized = false;
    let isVisible = true;
    let isRunning = false;

    const pointer = {
      x: -9999,
      y: -9999,
      radius: 60,
      isActive: false,
    };

    img.onload = () => {
      const naturalW = img.naturalWidth;
      const naturalH = img.naturalHeight;
      const targetW = 340;
      const targetH = Math.round(naturalH * (targetW / naturalW));

      canvas.width = targetW;
      canvas.height = targetH;

      const offscreen = document.createElement('canvas');
      offscreen.width = targetW;
      offscreen.height = targetH;
      const offCtx = offscreen.getContext('2d');
      if (!offCtx) return;

      offCtx.drawImage(img, 0, 0, targetW, targetH);
      const imgData = offCtx.getImageData(0, 0, targetW, targetH).data;

      particles = [];
      const step = 2; // Optimal high resolution with lightweight particle count (~8,500 points)

      for (let y = 0; y < targetH; y += step) {
        for (let x = 0; x < targetW; x += step) {
          const index = (y * targetW + x) * 4;
          const alpha = imgData[index + 3];

          if (alpha < 45) continue;

          const r = imgData[index];
          const g = imgData[index + 1];
          const b = imgData[index + 2];
          const lum = 0.299 * r + 0.587 * g + 0.114 * b;

          let density = Math.pow((255 - lum) / 255, 1.3);
          density = Math.max(density * 1.15, 0.08);

          if (Math.random() < density) {
            const jx = x + (Math.random() - 0.5) * 1.2;
            const jy = y + (Math.random() - 0.5) * 1.2;

            particles.push({
              homeX: jx,
              homeY: jy,
              x: jx,
              y: jy,
              vx: 0,
              vy: 0,
              radius: lum > 110 ? 0.8 : 1.25,
              luminance: lum,
            });
          }
        }
      }

      isInitialized = true;
      canvas.classList.add('ready');

      // Initial draw
      drawStatic();
    };

    function drawStatic() {
      if (!isInitialized || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const pColorBase = '15, 15, 20';
      const len = particles.length;

      for (let i = 0; i < len; i++) {
        const p = particles[i];
        p.x = p.homeX;
        p.y = p.homeY;
        p.vx = 0;
        p.vy = 0;

        const alpha = Math.max(0.4, ((255 - p.luminance) / 255) * 0.95);

        ctx.fillStyle = `rgba(${pColorBase}, ${alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Wake up loop on demand
    function startLoop() {
      if (!isRunning && isVisible && isInitialized) {
        isRunning = true;
        requestAnimationFrame(renderLoop);
      }
    }

    function updatePointerPosition(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      pointer.x = (clientX - rect.left) * scaleX;
      pointer.y = (clientY - rect.top) * scaleY;
      pointer.isActive = true;
      startLoop();
    }

    canvas.addEventListener('mousemove', (e) => {
      updatePointerPosition(e.clientX, e.clientY);
    });

    canvas.addEventListener('mouseleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
      pointer.isActive = false;
    });

    canvas.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches.length > 0) {
          updatePointerPosition(e.touches[0].clientX, e.touches[0].clientY);
        }
      },
      { passive: true }
    );

    canvas.addEventListener(
      'touchend',
      () => {
        pointer.x = -9999;
        pointer.y = -9999;
        pointer.isActive = false;
      },
      { passive: true }
    );

    // Ultra-lightweight Idle-Sleep Physics Loop
    function renderLoop() {
      if (!isInitialized || !isVisible) {
        isRunning = false;
        return;
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const pColorBase = '15, 15, 20';
      const pRadius = pointer.radius;
      const px = pointer.x;
      const py = pointer.y;

      const len = particles.length;
      let maxDisplacement = 0;

      for (let i = 0; i < len; i++) {
        const p = particles[i];

        if (pointer.isActive) {
          const dx = px - p.x;
          const dy = py - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < pRadius) {
            const force = (pRadius - dist) / pRadius;
            const angle = Math.atan2(dy, dx);
            const repelStrength = 14 * force;
            p.vx -= Math.cos(angle) * repelStrength;
            p.vy -= Math.sin(angle) * repelStrength;
          }
        }

        const homeDx = p.homeX - p.x;
        const homeDy = p.homeY - p.y;
        p.vx += homeDx * 0.08;
        p.vy += homeDy * 0.08;

        p.vx *= 0.82;
        p.vy *= 0.82;

        p.x += p.vx;
        p.y += p.vy;

        const displacement = Math.abs(homeDx) + Math.abs(homeDy) + Math.abs(p.vx) + Math.abs(p.vy);
        if (displacement > maxDisplacement) {
          maxDisplacement = displacement;
        }

        const alpha = Math.max(0.4, ((255 - p.luminance) / 255) * 0.95);
        ctx.fillStyle = `rgba(${pColorBase}, ${alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      }

      // IDLE PAUSE: If pointer is inactive and particles have settled back to home, STOP RAF!
      if (!pointer.isActive && maxDisplacement < 0.08) {
        isRunning = false;
        drawStatic(); // snap cleanly to resting home
        return;
      }

      requestAnimationFrame(renderLoop);
    }

    // Pause completely when out of viewport
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (!isVisible) {
            isRunning = false;
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(wrapper);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParticlePortrait);
  } else {
    initParticlePortrait();
  }
</script>
