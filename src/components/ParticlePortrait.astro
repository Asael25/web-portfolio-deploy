---
// ParticlePortrait.astro - Lightweight Static Stippled Portrait (PT Amman Style)
// Rendered once on canvas for pristine editorial art with 0% CPU overhead while scrolling
---

<div class="particle-portrait-wrapper" id="portraitWrapper">
  <canvas id="particlePortraitCanvas" class="particle-canvas"></canvas>
</div>

<style>
  .particle-portrait-wrapper {
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    user-select: none;
  }

  .particle-canvas {
    width: 100%;
    height: auto;
    max-height: 540px;
    display: block;
    cursor: default;
    filter: drop-shadow(0 16px 32px rgba(0, 0, 0, 0.06));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .particle-canvas.ready {
    opacity: 1;
  }

  @media (max-width: 968px) {
    .particle-portrait-wrapper {
      max-width: 280px;
    }

    .particle-canvas {
      max-height: 400px;
    }
  }

  @media (max-width: 480px) {
    .particle-portrait-wrapper {
      max-width: 230px;
    }

    .particle-canvas {
      max-height: 320px;
    }
  }
</style>

<script>
  function renderStippledPortrait() {
    const canvas = document.getElementById('particlePortraitCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const img = new Image();
    img.src = '/images/surya-hero-clean.png';
    img.crossOrigin = 'anonymous';

    img.onload = () => {
      const naturalW = img.naturalWidth;
      const naturalH = img.naturalHeight;
      const targetW = 340;
      const targetH = Math.round(naturalH * (targetW / naturalW));

      canvas.width = targetW;
      canvas.height = targetH;

      const offscreen = document.createElement('canvas');
      offscreen.width = targetW;
      offscreen.height = targetH;
      const offCtx = offscreen.getContext('2d');
      if (!offCtx) return;

      offCtx.drawImage(img, 0, 0, targetW, targetH);
      const imgData = offCtx.getImageData(0, 0, targetW, targetH).data;

      ctx.clearRect(0, 0, targetW, targetH);

      const step = 2; // High-resolution stippling point density
      const pColorBase = '15, 15, 20'; // Pristine deep obsidian ink

      for (let y = 0; y < targetH; y += step) {
        for (let x = 0; x < targetW; x += step) {
          const index = (y * targetW + x) * 4;
          const alpha = imgData[index + 3];

          if (alpha < 45) continue;

          const r = imgData[index];
          const g = imgData[index + 1];
          const b = imgData[index + 2];
          const lum = 0.299 * r + 0.587 * g + 0.114 * b;

          let density = Math.pow((255 - lum) / 255, 1.3);
          density = Math.max(density * 1.15, 0.08);

          if (Math.random() < density) {
            const jx = x + (Math.random() - 0.5) * 1.2;
            const jy = y + (Math.random() - 0.5) * 1.2;
            const radius = lum > 110 ? 0.8 : 1.25;
            const dotAlpha = Math.max(0.4, ((255 - lum) / 255) * 0.95);

            ctx.fillStyle = `rgba(${pColorBase}, ${dotAlpha})`;
            ctx.beginPath();
            ctx.arc(jx, jy, radius, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      canvas.classList.add('ready');
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderStippledPortrait);
  } else {
    renderStippledPortrait();
  }
</script>
