---
// ParticlePortrait.astro - Interactive 3D Point Cloud Stippled Portrait (PT Amman Style)
---

<div class="particle-portrait-wrapper" id="portraitWrapper">
  <canvas id="particlePortraitCanvas" class="particle-canvas"></canvas>
  <div class="portrait-hint font-mono">
    <span class="hint-pulse"></span>
    <span>ARAHKAN KURSOR / SENTUH UNTUK INTERAKSI PARTIKEL</span>
  </div>
</div>

<style>
  .particle-portrait-wrapper {
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    user-select: none;
  }

  .particle-canvas {
    width: 100%;
    height: auto;
    max-height: 540px;
    display: block;
    cursor: crosshair;
    filter: drop-shadow(0 16px 32px rgba(0, 0, 0, 0.08));
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .particle-canvas.ready {
    opacity: 1;
  }

  .portrait-hint {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    opacity: 0.75;
    pointer-events: none;
    transition: var(--transition);
  }

  .hint-pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: hintPulse 2s infinite ease-in-out;
  }

  @keyframes hintPulse {
    0%, 100% {
      opacity: 0.4;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  @media (max-width: 968px) {
    .particle-portrait-wrapper {
      max-width: 280px;
    }

    .particle-canvas {
      max-height: 400px;
    }
  }

  @media (max-width: 480px) {
    .particle-portrait-wrapper {
      max-width: 230px;
    }

    .particle-canvas {
      max-height: 320px;
    }

    .portrait-hint {
      font-size: 0.58rem;
    }
  }
</style>

<script>
  interface Particle {
    homeX: number;
    homeY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    density: number;
    ease: number;
    friction: number;
    luminance: number;
  }

  function initParticlePortrait() {
    const canvas = document.getElementById('particlePortraitCanvas') as HTMLCanvasElement;
    const wrapper = document.getElementById('portraitWrapper');
    if (!canvas || !wrapper) return;

    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return;

    // Load source image
    const img = new Image();
    img.src = '/images/surya-hero-clean.png';
    img.crossOrigin = 'anonymous';

    let particles: Particle[] = [];
    let isInitialized = false;
    let isVisible = true;
    let animId: number;

    const pointer = {
      x: -9999,
      y: -9999,
      radius: 65,
      isActive: false,
    };

    function isDark(): boolean {
      return document.documentElement.getAttribute('data-theme') === 'dark';
    }

    img.onload = () => {
      // 1. Establish canvas dimensions based on image aspect ratio
      const naturalW = img.naturalWidth;
      const naturalH = img.naturalHeight;
      const targetW = 340;
      const targetH = Math.round(naturalH * (targetW / naturalW));

      canvas.width = targetW;
      canvas.height = targetH;

      // 2. Offscreen sampling canvas
      const offscreen = document.createElement('canvas');
      offscreen.width = targetW;
      offscreen.height = targetH;
      const offCtx = offscreen.getContext('2d');
      if (!offCtx) return;

      offCtx.drawImage(img, 0, 0, targetW, targetH);
      const imgData = offCtx.getImageData(0, 0, targetW, targetH).data;

      // 3. Generate stippled particles (PT Amman Style)
      particles = [];
      const step = 2; // sample grid step

      for (let y = 0; y < targetH; y += step) {
        for (let x = 0; x < targetW; x += step) {
          const index = (y * targetW + x) * 4;
          const alpha = imgData[index + 3];

          if (alpha < 45) continue; // transparent pixel

          const r = imgData[index];
          const g = imgData[index + 1];
          const b = imgData[index + 2];
          const lum = 0.299 * r + 0.587 * g + 0.114 * b;

          // Stippling probability: darker areas have denser particles
          let density = Math.pow((255 - lum) / 255, 1.25);
          density = Math.max(density * 1.15, 0.07);

          if (Math.random() < density) {
            // Fine organic jitter
            const jx = x + (Math.random() - 0.5) * 1.4;
            const jy = y + (Math.random() - 0.5) * 1.4;

            // Spawn with gentle initial dispersion that magnetizes together
            const initialScatter = 40 + Math.random() * 80;
            const angle = Math.random() * Math.PI * 2;

            particles.push({
              homeX: jx,
              homeY: jy,
              x: jx + Math.cos(angle) * initialScatter,
              y: jy + Math.sin(angle) * initialScatter,
              vx: (Math.random() - 0.5) * 2,
              vy: (Math.random() - 0.5) * 2,
              radius: lum > 110 ? 0.85 : 1.25,
              density,
              ease: 0.055 + Math.random() * 0.035,
              friction: 0.84 + Math.random() * 0.05,
              luminance: lum,
            });
          }
        }
      }

      isInitialized = true;
      canvas.classList.add('ready');
      renderLoop();
    };

    // 4. Pointer Interaction tracking
    function updatePointerPosition(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      pointer.x = (clientX - rect.left) * scaleX;
      pointer.y = (clientY - rect.top) * scaleY;
      pointer.isActive = true;
    }

    canvas.addEventListener('mousemove', (e) => {
      updatePointerPosition(e.clientX, e.clientY);
    });

    canvas.addEventListener('mouseleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
      pointer.isActive = false;
    });

    // Touch support for mobile
    canvas.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches.length > 0) {
          updatePointerPosition(e.touches[0].clientX, e.touches[0].clientY);
        }
      },
      { passive: true }
    );

    canvas.addEventListener(
      'touchend',
      () => {
        pointer.x = -9999;
        pointer.y = -9999;
        pointer.isActive = false;
      },
      { passive: true }
    );

    // 5. Main Render Loop
    function renderLoop() {
      if (!isInitialized) return;
      animId = requestAnimationFrame(renderLoop);
      if (!isVisible) return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const dark = isDark();
      const pColorBase = dark ? '250, 250, 250' : '15, 15, 20';
      const pRadius = pointer.radius;
      const px = pointer.x;
      const py = pointer.y;

      const len = particles.length;

      for (let i = 0; i < len; i++) {
        const p = particles[i];

        // Repel from cursor when hovering
        if (pointer.isActive) {
          const dx = px - p.x;
          const dy = py - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < pRadius) {
            const force = (pRadius - dist) / pRadius;
            const angle = Math.atan2(dy, dx);
            const repelStrength = 18 * force;
            p.vx -= Math.cos(angle) * repelStrength;
            p.vy -= Math.sin(angle) * repelStrength;
          }
        }

        // Spring return force back to home position
        const homeDx = p.homeX - p.x;
        const homeDy = p.homeY - p.y;
        p.vx += homeDx * p.ease;
        p.vy += homeDy * p.ease;

        // Apply friction damping
        p.vx *= p.friction;
        p.vy *= p.friction;

        // Update positions
        p.x += p.vx;
        p.y += p.vy;

        // Particle opacity based on luminance
        let alpha = dark
          ? Math.max(0.3, (255 - p.luminance) / 255 * 0.95)
          : Math.max(0.4, (255 - p.luminance) / 255 * 0.95);

        // Draw particle
        ctx.fillStyle = `rgba(${pColorBase}, ${alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // 6. Pause when off-screen to preserve battery/GPU
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(wrapper);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParticlePortrait);
  } else {
    initParticlePortrait();
  }
</script>
