---
import Hero3D from './Hero3D.astro';
---

<section class="hero-section" id="hero">
  <Hero3D />
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-category font-mono">// FULL-STACK WEB & SOFTWARE DEVELOPER</div>

      <h1 class="hero-heading">
        <span class="name">Surya Asael</span>
        <span class="degree">, S.Kom</span>
      </h1>


      <p class="hero-description">
        Lulusan S1 Teknik Informatika <strong>Universitas 17 Agustus 1945 Surabaya</strong>. Berfokus pada rekayasa perangkat lunak dan arsitektur web <em>end-to-end</em> menggunakan <strong>Laravel</strong>, <strong>React.js</strong>, dan <strong>MySQL</strong>. Berpengalaman membangun sistem manajemen inventaris, e-archive kedinasan, serta platform web komersial klien.
      </p>

      <div class="hero-buttons">
        <a href="#projects" class="btn btn-primary">
          <span>Lihat Proyek Terpilih</span>
          <span class="font-mono">&darr;</span>
        </a>
        <a href="#contact" class="btn btn-outline">
          <span>Hubungi Saya</span>
          <span class="font-mono">&rarr;</span>
        </a>
      </div>

      <!-- Clean Specification Matrix (Anti AI-Slop) -->
      <div class="hero-specs font-mono">
        <div class="spec-row">
          <span class="spec-label">STATUS</span>
          <span class="spec-val">AVAILABLE FOR HIRE</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">EDUCATION</span>
          <span class="spec-val">S1 INFORMATIKA (IPK 3.62)</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">CERTIFICATION</span>
          <span class="spec-val">BNSP JR. WEB PROGRAMMER</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">LOCATION</span>
          <span class="spec-val">GRESIK, JAWA TIMUR, ID</span>
        </div>
      </div>
    </div>

    <!-- Right Side: Hero Visual (Frameless, HD, No Card Wrapper) -->
    <div class="hero-visual">
      <img 
        src="/images/surya-hero-clean.png" 
        alt="Surya Asael, S.Kom - Web & Software Developer" 
        class="hero-img"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 120px 0 70px;
    border-bottom: 1px solid var(--border-light);
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    pointer-events: none;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 50px;
    align-items: center;
  }

  .hero-content,
  .hero-visual {
    pointer-events: auto;
  }

  .hero-category {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    margin-bottom: 16px;
  }

  .hero-heading {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .degree {
    font-size: 0.6em;
    font-weight: 400;
    color: var(--text-muted);
  }

  .hero-lead {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .hero-description {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 30px;
    max-width: 620px;
  }

  .hero-description strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  /* Specification Matrix */
  .hero-specs {
    border-top: 1px solid var(--border-light);
    padding-top: 20px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 24px;
    font-size: 0.78rem;
  }

  .spec-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-label {
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .spec-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Right Side Photo (Frameless, HD Standalone Cutout, No Card Wrapper) */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
  }

  .hero-img {
    width: 100%;
    max-width: 360px;
    height: auto;
    max-height: 540px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.08));
    transition: transform 0.4s ease;
  }

  .hero-img:hover {
    transform: scale(1.02);
  }

  @media (max-width: 968px) {
    .hero-section {
      padding: 95px 0 50px;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: left;
    }

    .hero-visual {
      order: -1;
      width: 100%;
    }

    .hero-img {
      max-width: 280px;
      max-height: 380px;
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 85px 0 40px;
    }

    .hero-heading {
      font-size: 2.1rem;
      letter-spacing: -0.03em;
    }

    .hero-visual {
      max-width: 220px;
      margin: 0 auto;
    }

    .hero-img {
      max-width: 100%;
      max-height: 300px;
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
      gap: 10px;
    }

    .hero-buttons .btn {
      width: 100%;
      text-align: center;
    }

    .hero-specs {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
